# Reserved for the Google OIDC activation phase. The login preview needs no environment variables.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL connection for employee approvals and revocable sessions.
DATABASE_URL=

# Comma-separated, administrator-confirmed Google Workspace hosted domains.
# Future auth must reject sign-in if this list or the employee approval list is empty.
SKILLCONNECT_GOOGLE_HOSTED_DOMAINS=
