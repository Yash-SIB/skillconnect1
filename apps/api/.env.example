# Export variables to the Go process. Go does not load this file automatically.
API_ADDR=127.0.0.1:8080
DATABASE_URL=
TEST_DATABASE_URL=

# Comma-separated exact HTTP(S) Origin values. Empty rejects every upgrade.
WS_ALLOWED_ORIGINS=

# Optional Compose settings. Provide a password through the shell or an ignored .env file.
POSTGRES_USER=skillconnect
POSTGRES_DB=skillconnect
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
